import threading
num = list(map(int,input("Enter numbers : ").split()))
def square():
  print ("\n SQUARE")
  for n in num:
    print("Square of ",n,"=",n*n)
def cube():
  print ("\n CUBE")
  for n in num:
    print("Cube of ",n,"=",n*n*n)
t1 = threading.Thread(target=square)
t2 = threading.Thread(target=cube)
t1.start()
t1.join()
t2.start()
t2.join()
