import java.io.*;
import java.net.*;

public class Client {
    public static void main(String[] args) throws Exception {
        Socket clientEnd = new Socket("localhost", 6789);

        BufferedReader fromServer = new BufferedReader(
            new InputStreamReader(clientEnd.getInputStream()));

        PrintWriter toServer = new PrintWriter(
            clientEnd.getOutputStream(), true);

        toServer.println("Hello Server! This is a message from Client.");

        String serverMessage = fromServer.readLine();
        System.out.println("Server: " + serverMessage);

        clientEnd.close();
    }
}
